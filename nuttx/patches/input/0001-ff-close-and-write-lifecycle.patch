# Baseline: NuttX 76354c637858ecb0aa4601629327acb6f44a26bb
#
# The FF upper half retains effect ownership by file.  On close, stop and
# erase only effects owned by that file, returning the first lower-half error
# while never retaining a pointer to a closed file.  Validate write events at
# runtime, propagate playback errors, and prevent another file from playing a
# file-owned effect.  Cache the upper half before lower->destroy(), since a
# lower-half destroy callback may release its own object.

--- a/drivers/input/ff_upper.c
+++ b/drivers/input/ff_upper.c
@@ -212,15 +212,19 @@
       return ret;
     }
 
-  lower->playback(lower, effect_id, 0);
+  ret = lower->playback(lower, effect_id, 0);
 
   upper->effects[effect_id].owner = NULL;
   if (lower->erase != NULL)
     {
-      ret = lower->erase(lower, effect_id);
-      if (ret < 0)
+      int erase_ret = lower->erase(lower, effect_id);
+      if (erase_ret < 0)
         {
           upper->effects[effect_id].owner = filep;
+          if (ret == OK)
+            {
+              ret = erase_ret;
+            }
         }
     }
 
@@ -326,7 +330,35 @@
 
 static int ff_close(FAR struct file *filep)
 {
-  return OK;
+  FAR struct inode *inode = filep->f_inode;
+  FAR struct ff_upperhalf_s *upper = inode->i_private;
+  int ret = OK;
+  int tmp;
+  int id;
+
+  nxmutex_lock(&upper->lock);
+  for (id = 0; id < upper->max_effects; id++)
+    {
+      if (upper->effects[id].owner != filep)
+        {
+          continue;
+        }
+
+      tmp = ff_erase_effect(upper, id, filep);
+      if (tmp < 0)
+        {
+          /* A closed file cannot remain an effect owner. */
+
+          upper->effects[id].owner = NULL;
+          if (ret == OK)
+            {
+              ret = tmp;
+            }
+        }
+    }
+
+  nxmutex_unlock(&upper->lock);
+  return ret;
 }
 
 /****************************************************************************
@@ -339,14 +371,29 @@
   FAR struct inode *inode = filep->f_inode;
   FAR struct ff_upperhalf_s *upper = inode->i_private;
   FAR struct ff_event_s *event = (FAR struct ff_event_s *)buffer;
+  int ret;
 
-  DEBUGASSERT(buflen == sizeof(*event));
+  if (buffer == NULL || buflen != sizeof(*event))
+    {
+      return -EINVAL;
+    }
 
   nxmutex_lock(&upper->lock);
-  ff_event(upper->lower, event->code, event->value);
-  nxmutex_unlock(&upper->lock);
+  if (event->code == FF_GAIN || event->code == FF_AUTOCENTER)
+    {
+      ret = ff_event(upper->lower, event->code, event->value);
+    }
+  else
+    {
+      ret = ff_check_effect_access(upper, event->code, filep);
+      if (ret >= 0)
+        {
+          ret = ff_event(upper->lower, event->code, event->value);
+        }
+    }
 
-  return buflen;
+  nxmutex_unlock(&upper->lock);
+  return ret < 0 ? ret : buflen;
 }
 
 /****************************************************************************
@@ -575,12 +622,12 @@
       return;
     }
 
+  upper = lower->priv;
   if (lower->destroy != NULL)
     {
       lower->destroy(lower);
     }
 
-  upper = lower->priv;
   nxmutex_destroy(&upper->lock);
   kmm_free(upper);
 }
