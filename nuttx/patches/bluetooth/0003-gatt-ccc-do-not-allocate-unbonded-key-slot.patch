# Baseline: OpenVela NuttX 76354c637858ecb0aa4601629327acb6f44a26bb
#
# A CCC write is not a pairing operation.  Looking up its peer with
# bt_keys_get_addr() allocated an otherwise empty entry in the bounded key
# pool, then treated that entry as a bond.  Use the non-allocating long-term
# key lookups instead.  Either local or peer-distributed LTK keeps a bonded
# peer's CCC configuration persistent.
--- a/wireless/bluetooth/bt_gatt.c
+++ b/wireless/bluetooth/bt_gatt.c
@@ -294,14 +294,8 @@ int bt_gatt_attr_write_ccc(FAR struct bt_conn_s *conn,
       return -EINVAL;
     }
 
-  if (bt_keys_get_addr(&conn->dst))
-    {
-      bonded = true;
-    }
-  else
-    {
-      bonded = false;
-    }
+  bonded = bt_keys_find(BT_KEYS_LTK, &conn->dst) != NULL ||
+           bt_keys_find(BT_KEYS_SLAVE_LTK, &conn->dst) != NULL;
 
   for (i = 0; i < ccc->cfg_len; i++)
     {
