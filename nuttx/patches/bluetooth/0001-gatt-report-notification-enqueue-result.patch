-void bt_gatt_notify(uint16_t handle, FAR const void *data, size_t len)
+static int gatt_notify_common(FAR struct bt_conn_s *peer, uint16_t handle,
+                              FAR const void *data, size_t len)
 {
   struct notify_data_s nfy;
+
+  if (handle == 0 || (data == NULL && len != 0))
+    {
+      return -EINVAL;
+    }
 
   nfy.handle = handle;
   nfy.data   = data;
   nfy.len    = len;
+  nfy.result = -ENOTCONN;
+  nfy.peer   = peer;
 
   bt_gatt_foreach_attr(handle, 0xffff, notify_cb, &nfy);
+  return nfy.result;
+}
+
+int bt_gatt_notify_checked(uint16_t handle, FAR const void *data, size_t len)
+{
+  return gatt_notify_common(NULL, handle, data, len);
+}
+
+int bt_gatt_notify_peer(FAR struct bt_conn_s *peer, uint16_t handle,
+                        FAR const void *data, size_t len)
+{
+  if (peer == NULL)
+    {
+      return -EINVAL;
+    }
+
+  return gatt_notify_common(peer, handle, data, len);
+}
+
+void bt_gatt_notify(uint16_t handle, FAR const void *data, size_t len)
+{
+  (void)bt_gatt_notify_checked(handle, data, len);
 }
 
