@@ -856,6 +856,29 @@
 
 void bt_gatt_notify(uint16_t handle, FAR const void *data, size_t len);
 
+/* Return the number of notification PDUs passed to L2CAP, or a negative
+ * error when none were passed (-ENOTCONN: no subscribed connected peer;
+ * -ENOMEM: PDU allocation failed; -EINVAL: invalid arguments). A positive
+ * count may represent partial broadcast success and is not a peer receipt.
+ * A single-peer product may retry -ENOMEM with a bounded deadline. It must
+ * never retry a positive result as though no peer had been sent the PDU.
+ */
+
+int bt_gatt_notify_checked(uint16_t handle, FAR const void *data, size_t len);
+
+/* Connection-directed notification. Retain a callback's connection with
+ * bt_conn_addref() while asynchronous product work uses it, then release it.
+ * A retained disconnected connection cannot silently target its replacement.
+ * Return 1 if passed to L2CAP, otherwise a negative error as above.
+ */
+
+FAR struct bt_conn_s *bt_conn_addref(FAR struct bt_conn_s *conn);
+void bt_conn_release(FAR struct bt_conn_s *conn);
+int bt_gatt_notify_peer(FAR struct bt_conn_s *peer, uint16_t handle,
+                        FAR const void *data, size_t len);
+
