+/* Host-lifetime connection callbacks. Register once before accepting peers;
+ * callback storage must remain valid for the Host lifetime. Callbacks only
+ * enqueue state; advertising/disconnect commands belong to a worker.
+ */
+
+struct bt_conn_cb_s
+{
+  FAR struct bt_conn_cb_s *flink;
+  FAR void *context;
+
+  CODE void (*connected)(FAR struct bt_conn_s *conn, FAR void *context);
+  CODE void (*disconnected)(FAR struct bt_conn_s *conn, FAR void *context);
+};
+
+struct bt_eir_s;
+void bt_conn_cb_register(FAR struct bt_conn_cb_s *cb);
+int bt_conn_disconnect(FAR struct bt_conn_s *conn, uint8_t reason);
+int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
+                         FAR const struct bt_eir_s *sd);
+int bt_stop_advertising(void);
+
 #endif /* __INCLUDE_NUTTX_WIRELESS_BLUETOOTH_BT_GATT_H */
