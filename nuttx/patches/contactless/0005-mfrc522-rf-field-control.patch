--- a/drivers/contactless/mfrc522.c
+++ b/drivers/contactless/mfrc522.c
@@ -1629,6 +1629,22 @@
 
   switch (cmd)
     {
+      case MFRC522IOC_SET_RF:
+        if (arg > 1)
+          {
+            ret = -EINVAL;
+          }
+        else if (arg != 0)
+          {
+            mfrc522_enableantenna(dev);
+          }
+        else
+          {
+            mfrc522_writeu8(dev, MFRC522_COMMAND_REG, MFRC522_IDLE_CMD);
+            mfrc522_disableantenna(dev);
+          }
+        break;
+
       case MFRC522IOC_EXCHANGE:
         ret = mfrc522_exchange(dev, (FAR struct mfrc522_exchange_s *)arg);
         break;
