 {
--- a/drivers/contactless/mfrc522.c
+++ b/drivers/contactless/mfrc522.c
@@ -1530,6 +1530,51 @@
  * Name: mfrc522_ioctl
  ****************************************************************************/
 
+static int mfrc522_exchange(FAR struct mfrc522_dev_s *dev,
+                           FAR struct mfrc522_exchange_s *exchange)
+{
+  uint8_t tx[64];
+  uint8_t rx[64];
+  uint8_t length = sizeof(rx);
+  uint8_t bits = 0;
+  int ret;
+
+  if (exchange == NULL)
+    {
+      return -EINVAL;
+    }
+
+  exchange->rx_length = 0;
+  memset(exchange->rx, 0, sizeof(exchange->rx));
+  if (exchange->tx_length == 0 ||
+      exchange->tx_length > sizeof(exchange->tx))
+    {
+      return -EINVAL;
+    }
+
+  memcpy(tx, exchange->tx, exchange->tx_length);
+  ret = mfrc522_calc_crc(dev, tx, exchange->tx_length,
+                         tx + exchange->tx_length);
+  if (ret == OK)
+    {
+      ret = mfrc522_transcv_data(dev, tx, exchange->tx_length + 2,
+                                 rx, &length, &bits, 0, true);
+    }
+
+  if (ret == OK)
+    {
+      if (bits != 0 || length < 2 || length > sizeof(rx))
+        {
+          return -EPROTO;
+        }
+
+      exchange->rx_length = length - 2;
+      memcpy(exchange->rx, rx, exchange->rx_length);
+    }
+
+  return ret;
+}
+
 static int mfrc522_ioctl(FAR struct file *filep, int cmd, unsigned long arg)
 {
   FAR struct inode *inode;
