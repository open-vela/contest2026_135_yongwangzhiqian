config TESTS_BK7258_RPMSG_EXEC
	bool "BK7258 AP driver-check commands over RPMsg"
	default n
	depends on ARCH_CHIP_BK7258 && BK7258_AP_CORE && BK7258_RPTUN
	select BK7258_AP_APPLICATION_LIFECYCLE
	select NET
	select NET_RPMSG
	select NET_LOCAL
	select NET_LOCAL_STREAM
	select NETUTILS_REXECD
	select NSH_LIBRARY
	select NSH_CONSOLE
	select SYSTEM_READLINE
	select NSH_BUILTIN_APPS
	select BUILTIN
	select SYSTEM_POPEN
	select PIPES
	select LIBC_EXECFUNCS
	help
		Start the official rexecd application with AF_RPMSG after normal AP
		startup.  CP can run selected standard driver tests without an AP
		UART console.  This belongs only in explicit drivercheck profiles;
		it does not start an IPv4/IPv6 listener or run tests automatically.

config TESTS_BK7258_CMOCKA
	tristate "BK7258 CP/AP lifecycle contract tests"
	default n
	depends on TESTING_CMOCKA
	depends on ARCH_SETJMP_H
	depends on ARCH_CHIP_BK7258
	depends on ARCH_BOARD_BK7258
	depends on !BK7258_AP_CORE
	depends on BK7258_AP_CONTROL
	help
		Build the target-side CMocka contract shared by every maintained
		BK7258 physical board.  It publishes the configured board identity
		and verifies the public UART0 device contract and the versioned AP
		lifecycle and supervisor interfaces without calling vendor SDK APIs.

if TESTS_BK7258_CMOCKA

config TESTS_BK7258_CMOCKA_PRIORITY
	int "BK7258 CMocka task priority"
	default 100

config TESTS_BK7258_CMOCKA_STACKSIZE
	int "BK7258 CMocka task stack size"
	default 4096

endif
