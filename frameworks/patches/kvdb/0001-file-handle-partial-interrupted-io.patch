Subject: [PATCH] kvdb: preserve progress and errors in file backend I/O

SPDX-License-Identifier: Apache-2.0
Base: open-vela/frameworks_system_utils 5e582301ffa1401d1e48d49cea46edeba97b822e

--- a/kvdb/file.c
+++ b/kvdb/file.c
@@ -63,21 +63,31 @@
     }
 
     while (nbyteswrite < val_len) {
-        result = write(fd, value, val_len);
+        result = write(fd, (const char*)value + nbyteswrite,
+            val_len - nbyteswrite);
         if (result < 0) {
-            if (result == -EINTR) {
+            int error = errno;
+            if (error == EINTR) {
                 continue;
             }
 
-            KVERR("write %s error with %d", filepath, errno);
+            KVERR("write %s error with %d", filepath, error);
             close(fd);
-            return -errno;
+            return -error;
+        }
+
+        if (result == 0) {
+            close(fd);
+            return -EIO;
         }
 
         nbyteswrite += result;
     }
 
-    close(fd);
+    if (close(fd) < 0) {
+        return -errno;
+    }
+
     return 0;
 }
 
@@ -112,8 +122,8 @@
         return -errno;
     }
 
-    do {
-        result = read(fd, value + nbytesread, val_len - nbytesread);
+    while (nbytesread < val_len) {
+        result = read(fd, (char*)value + nbytesread, val_len - nbytesread);
         if (result < 0) {
             result = -errno;
             if (result == -EINTR) {
@@ -126,8 +136,12 @@
             return ret;
         }
 
+        if (result == 0) {
+            break;
+        }
+
         nbytesread += result;
-    } while (result > 0 && nbytesread < val_len);
+    }
 
     ret = nbytesread;
     close(fd);
@@ -158,7 +172,6 @@
 
         ret = kvdb_file_get(path, entry->d_name, value, PROP_VALUE_MAX);
         if (ret < 0) {
-            ret = -errno;
             break;
         }
 
@@ -179,7 +192,11 @@
     char filepath[PATH_MAX];
 
     kvdb_file_genpath(path, key, filepath);
-    return unlink(filepath);
+    if (unlink(filepath) < 0) {
+        return -errno;
+    }
+
+    return 0;
 }
 
 #ifdef CONFIG_KVDB_FILE
