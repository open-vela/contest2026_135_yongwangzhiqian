Subject: [PATCH] kvdb: use journaled explicit UnQLite commits

SPDX-License-Identifier: Apache-2.0
Base: open-vela/frameworks_system_utils 5e582301ffa1401d1e48d49cea46edeba97b822e

--- a/kvdb/unqlite.c
+++ b/kvdb/unqlite.c
@@ -14,6 +14,7 @@
  * limitations under the License.
  */
 
+#include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
 
@@ -32,7 +33,25 @@
 
 struct kvdb {
     unqlite* db;
+    bool failed;
 };
+
+/* UnQLite error numbers are not POSIX errno values. */
+static int kvdb_unqlite_error(int ret)
+{
+    switch (ret) {
+    case UNQLITE_OK: return 0;
+    case UNQLITE_NOTFOUND: return -ENOENT;
+    case UNQLITE_NOMEM: return -ENOMEM;
+    case UNQLITE_BUSY: case UNQLITE_LOCKED: return -EBUSY;
+    case UNQLITE_INVALID: return -EINVAL;
+    case UNQLITE_PERM: return -EACCES;
+    case UNQLITE_READ_ONLY: return -EROFS;
+    case UNQLITE_FULL: case UNQLITE_LIMIT: return -ENOSPC;
+    case UNQLITE_CORRUPT: return -EBADMSG;
+    default: return -EIO;
+    }
+}
 
 /****************************************************************************
  * Database Functions
@@ -40,23 +59,27 @@
 
 int kvdb_persist_set(struct kvdb* kvdb, const char* key, size_t key_len, const void* value, size_t val_len, bool force)
 {
+    if (kvdb->failed) return -EIO;
+
     int ret = unqlite_kv_store(kvdb->db, key, key_len, value, val_len);
     if (ret < 0) {
         KVERR("kv_store key:%s key_len:%d error %d!\n", key, (int)key_len, ret);
-        return ret;
-    }
-
-    return ret;
+        return kvdb_unqlite_error(ret);
+    }
+
+    return kvdb_unqlite_error(ret);
 }
 
 ssize_t kvdb_persist_get(struct kvdb* kvdb, const char* key, size_t key_len, void* value, size_t val_len)
 {
+    if (kvdb->failed) return -EIO;
+
     unqlite_int64 val_size = val_len;
     ssize_t ret = unqlite_kv_fetch(kvdb->db, key, key_len, value, &val_size);
     if (ret < 0) {
         if (ret != UNQLITE_NOTFOUND)
             KVERR("kv_fetch key:%s key_len:%d error %d!\n", key, (int)key_len, ret);
-        return ret;
+        return kvdb_unqlite_error(ret);
     }
 
     if (val_size <= 0)
@@ -67,13 +90,15 @@
 
 int kvdb_persist_delete(struct kvdb* kvdb, const char* key, size_t key_len)
 {
+    if (kvdb->failed) return -EIO;
+
     int ret = unqlite_kv_delete(kvdb->db, key, key_len);
     if (ret < 0) {
         KVERR("kv_delete key:%s key_len:%d error %d!\n", key, (int)key_len, ret);
-        return ret;
-    }
-
-    return ret;
+        return kvdb_unqlite_error(ret);
+    }
+
+    return kvdb_unqlite_error(ret);
 }
 
 static int kvdb_list_value(const void* value, unsigned int len, void* arg)
@@ -101,7 +126,11 @@
 int kvdb_persist_list(struct kvdb* kvdb, kvdb_consume consume, void* cookie)
 {
     unqlite_kv_cursor* cur = NULL;
-    unqlite_kv_cursor_init(kvdb->db, &cur);
+    int ret;
+
+    if (kvdb->failed) return -EIO;
+    ret = unqlite_kv_cursor_init(kvdb->db, &cur);
+    if (ret != UNQLITE_OK) return kvdb_unqlite_error(ret);
 
     kvdb_consume_data data = {
         .consume = consume,
@@ -109,15 +138,23 @@
         .cur = cur,
     };
 
-    unqlite_kv_cursor_first_entry(cur);
+    ret = unqlite_kv_cursor_first_entry(cur);
+    if (ret != UNQLITE_OK && ret != UNQLITE_DONE && ret != UNQLITE_EOF) {
+        unqlite_kv_cursor_release(kvdb->db, cur);
+        return kvdb_unqlite_error(ret);
+    }
     while (unqlite_kv_cursor_valid_entry(cur)) {
-        int ret = unqlite_kv_cursor_key_callback(cur, kvdb_list_key, &data);
+        ret = unqlite_kv_cursor_key_callback(cur, kvdb_list_key, &data);
         if (ret < 0) { /* exit loop demanded by consume */
             KVERR("kv_cursor_key_callback failed error %d!\n", ret);
             unqlite_kv_cursor_release(kvdb->db, cur);
-            return ret;
+            return kvdb_unqlite_error(ret);
         }
-        unqlite_kv_cursor_next_entry(cur);
+        ret = unqlite_kv_cursor_next_entry(cur);
+        if (ret != UNQLITE_OK && ret != UNQLITE_DONE && ret != UNQLITE_EOF) {
+            unqlite_kv_cursor_release(kvdb->db, cur);
+            return kvdb_unqlite_error(ret);
+        }
     }
     unqlite_kv_cursor_release(kvdb->db, cur);
 
@@ -126,12 +163,19 @@
 
 int kvdb_persist_commit(struct kvdb* kvdb)
 {
-    int ret = unqlite_commit(kvdb->db);
-    if (ret < 0) {
-        KVERR("commit db:%p error %d!\n", kvdb->db, ret);
-    }
-
-    return ret;
+    int ret;
+
+    if (kvdb->failed) return -EIO;
+
+    ret = unqlite_commit(kvdb->db);
+    if (ret != UNQLITE_OK) {
+        /* Failed transactions must not be committed by a later close/retry. */
+        if (unqlite_rollback(kvdb->db) != UNQLITE_OK) {
+            kvdb->failed = true;
+        }
+    }
+
+    return kvdb_unqlite_error(ret);
 }
 
 void kvdb_persist_uninit(struct kvdb* kvdb)
@@ -152,12 +196,21 @@
 
     /* open database */
 
-    ret = unqlite_open(&(*kvdb)->db, CONFIG_KVDB_PERSIST_PATH, UNQLITE_OPEN_CREATE | UNQLITE_OPEN_OMIT_JOURNALING);
-
-    if (ret < 0) {
-        KVERR("unqlite_open failed error %d!\n", ret);
+    ret = unqlite_open(&(*kvdb)->db, CONFIG_KVDB_PERSIST_PATH, UNQLITE_OPEN_CREATE);
+
+    if (ret != UNQLITE_OK) {
         free(*kvdb);
-    }
-
-    return ret;
-}
+        *kvdb = NULL;
+        return kvdb_unqlite_error(ret);
+    }
+
+    /* All writes require an explicit, error-reporting commit. */
+    ret = unqlite_config((*kvdb)->db, UNQLITE_CONFIG_DISABLE_AUTO_COMMIT);
+    if (ret != UNQLITE_OK) {
+        unqlite_close((*kvdb)->db);
+        free(*kvdb);
+        *kvdb = NULL;
+    }
+
+    return kvdb_unqlite_error(ret);
+}
--- a/kvdb/direct.c
+++ b/kvdb/direct.c
@@ -66,6 +66,9 @@
         return ret;
 
     ret = kvdb_set(client, key, key_len, value, val_len, false);
+    if (ret >= 0) {
+        ret = kvdb_commit(client);
+    }
     kvdb_uninit(client);
     return ret;
 }
@@ -144,6 +147,9 @@
         return ret;
 
     ret = kvdb_delete(client, key, key_len);
+    if (ret >= 0) {
+        ret = kvdb_commit(client);
+    }
     kvdb_uninit(client);
     return ret;
 }
