# BK7258_BUNDLE_TREE_SHA256=20c622d9b10a5e6965a592126d0739f2f3af95cf510fb24a08d606840cc509d4
# BK7258 AIDK AP SDK overlay: four-line SDIO with TX DMA and hardware SCCB.
# The T5 base profile uses simulated I2C2; AIDK routes I2C1 to P42/P43.
CONFIG_SDCARD_BUSWIDTH_4LINE=y
# CONFIG_SDIO_4LINES_EN is not set
CONFIG_DVP_CAMERA_I2C_ID=1
CONFIG_SDIO_GDMA_EN=y
