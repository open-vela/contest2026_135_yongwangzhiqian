+/* Bounded GC2145 timing readback. No sensor state is changed. */
+static void dvp_gc2145_timing(dvp_driver_handle_t *handle, const char *phase)
+{
+    static const uint8_t regs[] = {0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
+                                   0x0d, 0x0e, 0xf7, 0xf8, 0xfa, 0xb6,
+                                   0x0f, 0x10, 0x11, 0x12, 0xf9, 0xfd};
+    uint32_t val[sizeof(regs)] = {0};
+    uint32_t page = 0;
+    if (handle == NULL || handle->sensor == NULL ||
+        handle->sensor->id != ID_GC2145 || handle->sensor->read_register == NULL)
+        return;
+    int ret = handle->sensor->read_register(0xfe, &page);
+    if (ret != 0 || page != 0)
+    {
+        LOGW("GC2145 TIMING phase=%s page=%x ret=%d skipped\r\n", phase, page, ret);
+        return;
+    }
+    for (unsigned int i = 0; i < sizeof(regs); ++i)
+    {
+        ret = handle->sensor->read_register(regs[i], &val[i]);
+        if (ret != 0)
+        {
+            LOGW("GC2145 TIMING phase=%s reg=%02x ret=%d failed\r\n", phase, regs[i], ret);
+            return;
+        }
+    }
+    LOGI("GC2145 TIMING phase=%s fps_enum=%u p0_03_04=%02x%02x p0_05_06=%02x%02x "
+         "p0_07_08=%02x%02x p0_0d_0e=%02x%02x f7=%02x f8=%02x fa=%02x b6=%02x\r\n",
+         phase, handle->config->fps, val[0], val[1], val[2], val[3],
+         val[4], val[5], val[6], val[7], val[8], val[9], val[10], val[11]);
+    uint32_t width = ((val[12] & 0x07) << 8) | val[13];
+    uint32_t sh_delay = ((val[14] & 0x03) << 8) | val[15];
+    uint32_t hblank = ((val[2] & 0x0f) << 8) | val[3];
+    uint32_t height = ((val[6] & 0x07) << 8) | val[7];
+    uint32_t vblank = ((val[4] & 0x1f) << 8) | val[5];
+    uint32_t exposure = ((val[0] & 0x1f) << 8) | val[1];
+    uint32_t frame_rows = height + vblank;
+    if (exposure > frame_rows)
+        frame_rows = exposure;
+    LOGI("GC2145 CLOCK phase=%s p0_0f_10=%02x%02x p0_11_12=%02x%02x "
+         "f9=%02x fd=%02x row_ticks=%u frame_rows=%u pixel_rate=unverified\r\n",
+         phase, val[12], val[13], val[14], val[15], val[16], val[17],
+         hblank + sh_delay + width + 4, frame_rows);
+}
