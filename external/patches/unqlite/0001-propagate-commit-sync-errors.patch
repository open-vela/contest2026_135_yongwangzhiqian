Subject: [PATCH] pager: preserve journal on commit sync failure

SPDX-License-Identifier: BSD-2-Clause
Base: open-vela/external_unqlite 25731ab0e2a4aa119df1329f799cd571a794720c

--- a/unqlite.c
+++ b/unqlite.c
@@ -53835,14 +53835,9 @@
     ** then the directory sync is superfluous.
     */
     if( (!HAVE_FULLFSYNC || !isFullsync) && full_fsync(pFile->dirfd,0,0) ){
-       /*
-       ** We have received multiple reports of fsync() returning
-       ** errors when applied to directories on certain file systems.
-       ** A failed directory sync is not a big deal.  So it seems
-       ** better to ignore the error.  Ticket #1657
-       */
-       /* pFile->lastErrno = errno; */
-       /* return UNQLITE_IOERR; */
+       /* Directory durability is required when dirsync is enabled. */
+       pFile->lastErrno = errno;
+       return UNQLITE_IOERR;
     }
 #endif
     err = close(pFile->dirfd); /* Only need to sync once, so close the */
@@ -56427,8 +56422,8 @@
 	/* Release the temp page */
 	SyMemBackendFree(pPager->pAllocator,(void *)zTmp);
 	if( rc == UNQLITE_OK ){
-		/* Sync the database file */
-		unqliteOsSync(pPager->pfd,UNQLITE_SYNC_FULL);
+		/* Do not discard recovery data if replayed pages failed to sync. */
+		rc = unqliteOsSync(pPager->pfd,UNQLITE_SYNC_FULL);
 	}
 	if( rc == UNQLITE_DONE ){
 		rc = UNQLITE_OK;
@@ -56618,8 +56613,11 @@
 		unqliteGenError(pPager->pDb,"Cannot acquire an exclusive lock on the database while journal rollback");
 		goto fail;
 	}
-	/* Sync the journal file */
-	unqliteOsSync(pPager->pjfd,UNQLITE_SYNC_NORMAL);
+	/* Sync the journal file before changing the database. */
+	rc = unqliteOsSync(pPager->pjfd,UNQLITE_SYNC_NORMAL);
+	if( rc != UNQLITE_OK ){
+		goto fail;
+	}
 	/* Finally rollback the database */
 	rc = pager_playback(pPager);
 	/* Switch back to shared lock */
@@ -57054,14 +57052,16 @@
 	}
 	/* Sync the journal and close it */
 	rc = unqliteOsSync(pPager->pjfd,UNQLITE_SYNC_NORMAL);
+	if( rc != UNQLITE_OK ){
+		return rc;
+	}
 	if( close_jrnl ){
-		/* close the journal file */
-		if( UNQLITE_OK != unqliteOsCloseFree(pPager->pAllocator,pPager->pjfd) ){
-			if( rc != UNQLITE_OK /* unqliteOsSync */ ){
-				return rc;
-			}
-		}
+		/* CloseFree releases the allocation even when close fails. */
+		rc = unqliteOsCloseFree(pPager->pAllocator,pPager->pjfd);
 		pPager->pjfd = 0;
+		if( rc != UNQLITE_OK ){
+			return rc;
+		}
 	}
 	if( (*pRetry) == 1 ){
 		if( pager_lock_db(pPager,EXCLUSIVE_LOCK) == UNQLITE_OK ){
@@ -57250,7 +57250,11 @@
 	}
 	if( pPager->iFlags & PAGER_CTRL_DIRTY_COMMIT ){
 		/* Sync the database first if a dirty commit have been applied */
-		unqliteOsSync(pPager->pfd,UNQLITE_SYNC_NORMAL);
+		rc = unqliteOsSync(pPager->pfd,UNQLITE_SYNC_NORMAL);
+		if( rc != UNQLITE_OK ){
+			pPager->iFlags |= PAGER_CTRL_COMMIT_ERR;
+			return rc;
+		}
 	}
 	/* Write the dirty pages */
 	rc = pager_write_dirty_pages(pPager,pDirty);
@@ -57278,10 +57282,18 @@
      * then use unqliteOsTruncate to grow or shrink the file here.
      */
 	if( pPager->dbSize != pPager->dbOrigSize ){
-		unqliteOsTruncate(pPager->pfd,pPager->iPageSize * pPager->dbSize);
-	}
-	/* Sync the database file */
-	unqliteOsSync(pPager->pfd,UNQLITE_SYNC_FULL);
+		rc = unqliteOsTruncate(pPager->pfd,pPager->iPageSize * pPager->dbSize);
+		if( rc != UNQLITE_OK ){
+			pPager->iFlags |= PAGER_CTRL_COMMIT_ERR;
+			return rc;
+		}
+	}
+	/* Keep the rollback journal until the database is durable. */
+	rc = unqliteOsSync(pPager->pfd,UNQLITE_SYNC_FULL);
+	if( rc != UNQLITE_OK ){
+		pPager->iFlags |= PAGER_CTRL_COMMIT_ERR;
+		return rc;
+	}
 	/* Remove stale flags */
 	pPager->iJournalOfft = 0;
 	pPager->nRec = 0;
@@ -57292,14 +57304,19 @@
  */
 static int pager_commit_phase2(Pager *pPager)
 {
+	int rc;
 	if( !pPager->is_mem ){
 		if( pPager->iState == PAGER_OPEN ){
 			return UNQLITE_OK;
 		}
 		if( pPager->iState != PAGER_READER ){
 			if( !pPager->no_jrnl ){
-				/* Finally, unlink the journal file */
-				unqliteOsDelete(pPager->pVfs,pPager->zJournal,1);
+				/* Failed journal removal must not acknowledge a commit. */
+				rc = unqliteOsDelete(pPager->pVfs,pPager->zJournal,1);
+				if( rc != UNQLITE_OK ){
+					pPager->iFlags |= PAGER_CTRL_COMMIT_ERR;
+					return rc;
+				}
 			}
 			/* Downgrade to shared lock */
 			pager_unlock_db(pPager,SHARED_LOCK);
@@ -57502,8 +57519,11 @@
 		if( !pPager->no_jrnl ){
 			/* Close any outstanding joural file */
 			if( pPager->pjfd ){
-				/* Sync the journal file */
-				unqliteOsSync(pPager->pjfd,UNQLITE_SYNC_NORMAL);
+				/* Retain the journal if rollback cannot sync it. */
+				rc = unqliteOsSync(pPager->pjfd,UNQLITE_SYNC_NORMAL);
+				if( rc != UNQLITE_OK ){
+					return rc;
+				}
 			}
 			unqliteOsCloseFree(pPager->pAllocator,pPager->pjfd);
 			pPager->pjfd = 0;
